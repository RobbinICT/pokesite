{% extends 'admin/layout.html.twig' %}

{#
    Add / edit form, shared by every collectable type.
    Params: collectable, form, item (null when adding), item_title, image,
            duplicate ({id, title, subtitle} or null), return_url
#}

{% form_theme form 'admin/_form_theme.html.twig' %}

{% set is_new = item is null %}
{% set placeholder = asset('images/placeholder/card_placeholder.png') %}

{% block title %}{{ is_new ? 'Add ' ~ collectable.itemLabel : 'Edit ' ~ item_title }}{% endblock %}

{% block body %}
    {# Breadcrumb + title ------------------------------------------------- #}
    <a href="{{ return_url }}" class="mb-2 inline-flex items-center gap-1 text-sm font-semibold text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        {{ collectable.label }}
    </a>
    <div class="mb-5 flex flex-wrap items-center gap-3">
        <h1 class="mr-auto text-2xl font-extrabold tracking-tight text-gray-900 dark:text-white">
            {{ is_new ? 'Add ' ~ collectable.itemLabel : item_title }}
        </h1>
        {% if not is_new %}
            <button type="button" class="btn btn--ghost text-pokered dark:text-red-400"
                    data-delete-action="{{ path('admin_delete', { type: collectable.key, id: item.id }) }}"
                    data-delete-token="{{ csrf_token('delete-' ~ collectable.key ~ '-' ~ item.id) }}"
                    data-delete-title="{{ item_title }}"
                    data-delete-subtitle="{{ collectable.subtitle(item) }}"
                    data-delete-image="{{ image }}">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3"/></svg>
                Delete
            </button>
        {% endif %}
    </div>

    {{ form_start(form, { attr: { novalidate: 'novalidate', 'data-admin-form': true } }) }}
        <input type="hidden" name="_return" value="{{ return_url }}">

        <div class="grid items-start gap-5 lg:grid-cols-[minmax(0,1fr)_18rem]">
            {# Fields ---------------------------------------------------------- #}
            <div class="admin-panel">
                <div class="p-5 sm:p-6">
                    {{ form_errors(form) }}

                    {% if duplicate %}
                        <div class="mb-5 flex items-start gap-3 rounded-lg border border-pokeyellow/60 bg-pokeyellow/10 px-4 py-3 text-sm dark:border-pokeyellow/30" role="alert">
                            <svg class="mt-0.5 h-5 w-5 flex-none text-yellow-600 dark:text-pokeyellow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg>
                            <p class="text-gray-800 dark:text-gray-200">
                                <span class="font-semibold">Already in your collection:</span>
                                {{ duplicate.title }} <span class="text-gray-500 dark:text-gray-400">({{ duplicate.subtitle }})</span>.
                                <a href="{{ path('admin_edit', { type: collectable.key, id: duplicate.id, return: return_url }) }}"
                                   class="font-semibold text-pokeblue hover:underline dark:text-blue-400">Edit that one →</a>
                            </p>
                        </div>
                    {% endif %}

                    <div class="grid gap-x-4 gap-y-5 sm:grid-cols-2">
                        {% for child in form %}
                            {% if child.vars.name != '_token' %}{{ form_row(child) }}{% endif %}
                        {% endfor %}
                    </div>
                </div>

                {# Actions --------------------------------------------------- #}
                <div class="flex flex-wrap items-center justify-end gap-2 rounded-b-xl border-t border-gray-100 bg-gray-50 px-5 py-3 sm:px-6 dark:border-gray-800 dark:bg-gray-950/40">
                    <span class="mr-auto hidden text-xs text-gray-400 md:inline">
                        <kbd class="rounded border border-gray-200 px-1 font-sans dark:border-gray-700">⌘/Ctrl</kbd> + <kbd class="rounded border border-gray-200 px-1 font-sans dark:border-gray-700">Enter</kbd> to save
                    </span>
                    <a href="{{ return_url }}" class="btn btn--ghost">Cancel</a>
                    {% if is_new %}
                        <button type="submit" name="add_another" value="1" class="btn btn--ghost">Save &amp; add another</button>
                    {% endif %}
                    <button type="submit" class="btn btn--primary">{{ is_new ? 'Add ' ~ collectable.itemLabel : 'Save changes' }}</button>
                </div>
            </div>

            {# Live preview ---------------------------------------------------- #}
            <aside class="admin-panel p-4 lg:sticky lg:top-20" aria-label="Image preview">
                <p class="admin-nav-heading px-0 pt-0">Preview</p>
                <div class="relative mt-2 grid aspect-card w-full place-items-center overflow-hidden rounded-lg bg-gray-50 ring-1 ring-gray-200 dark:bg-gray-950 dark:ring-gray-800">
                    <img class="h-full w-full object-contain" alt="" data-preview-image {% if image %}src="{{ image }}"{% else %}hidden{% endif %}>
                    <div class="flex flex-col items-center gap-2 px-6 text-center text-xs text-gray-400" data-preview-empty {{ image ? 'hidden' }}>
                        <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="m21 16-5-5-9 9"/></svg>
                        <span>Paste an image URL to see a preview</span>
                    </div>
                    <div class="flex flex-col items-center gap-2 px-6 text-center text-xs font-semibold text-pokered dark:text-red-400" data-preview-error hidden>
                        <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg>
                        <span>This image can't be loaded. Check the URL.</span>
                    </div>
                </div>
                <p class="mt-3 truncate text-sm font-semibold text-gray-900 dark:text-white" data-preview-title>{{ item_title }}</p>
            </aside>
        </div>
    {{ form_end(form) }}

    {% if not is_new %}
        {% include 'admin/_delete_modal.html.twig' with { collectable: collectable, return_url: return_url } only %}
    {% endif %}
{% endblock %}

{% block javascripts %}
    <script>
        (function () {
            const form = document.querySelector('[data-admin-form]');

            // Live image preview -------------------------------------------
            const source = form.querySelector('[data-image-preview-source]');
            const img = document.querySelector('[data-preview-image]');
            const empty = document.querySelector('[data-preview-empty]');
            const error = document.querySelector('[data-preview-error]');
            const initial = img.getAttribute('src');
            const show = (state) => {
                img.hidden = state !== 'image';
                empty.hidden = state !== 'empty';
                error.hidden = state !== 'error';
            };
            img.addEventListener('load', () => show('image'));
            img.addEventListener('error', () => show(img.getAttribute('src') ? 'error' : 'empty'));
            let timer;
            source.addEventListener('input', () => {
                clearTimeout(timer);
                timer = setTimeout(() => {
                    const url = source.value.trim();
                    if (url === '') {
                        // Fall back to the stored image when the URL is cleared.
                        if (initial) { img.src = initial; } else { img.removeAttribute('src'); show('empty'); }
                        return;
                    }
                    img.src = url;
                }, 300);
            });

            // Live title ----------------------------------------------------
            const name = form.querySelector('[name$="[name]"]');
            const title = document.querySelector('[data-preview-title]');
            if (name) {
                name.addEventListener('input', () => { title.textContent = name.value; });
            }

            // Temporary identifier ("temp-venom") ---------------------------
            const tempButton = form.querySelector('[data-temp-id-generate]');
            if (tempButton) {
                const target = form.querySelector('[data-temp-id-target]');
                tempButton.addEventListener('click', () => {
                    const slug = (name ? name.value : '')
                        .normalize('NFD').replace(/[̀-ͯ]/g, '')
                        .toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
                    target.value = '{{ constant('App\\Entity\\Minifigure::TEMPORARY_PREFIX') }}' + (slug || Date.now().toString(36));
                    target.focus();
                });
            }

            // Cmd/Ctrl + Enter saves ----------------------------------------
            form.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) {
                    e.preventDefault();
                    form.requestSubmit(form.querySelector('.btn--primary[type="submit"]'));
                }
            });
        })();
    </script>
{% endblock %}
