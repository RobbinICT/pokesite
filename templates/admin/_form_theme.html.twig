{#
    Tailwind form theme for the admin forms.
#}
{% use 'form_div_layout.html.twig' with
    form_widget_simple as base_form_widget_simple,
    form_label as base_form_label,
    form_label_content as base_form_label_content,
    form_help as base_form_help %}

{%- block form_row -%}
    <div{% with { attr: row_attr } %}{{ block('attributes') }}{% endwith %}>
        {{- form_label(form) -}}
        {%- if attr['data-temp-id-target'] is defined -%}
            <div class="flex gap-2">
                {{- form_widget(form) -}}
                <button type="button" class="btn btn--ghost flex-none px-3" data-temp-id-generate
                        title="Fill in a temporary ID based on the name">Temp ID</button>
            </div>
        {%- else -%}
            {{- form_widget(form) -}}
        {%- endif -%}
        {{- form_errors(form) -}}
        {{- form_help(form) -}}
    </div>
{%- endblock form_row -%}

{%- block form_widget_simple -%}
    {%- if type|default('text') != 'hidden' -%}
        {%- set attr = attr|merge({ class: (attr.class|default('') ~ ' admin-input' ~ (errors|length > 0 ? ' admin-input--error' : ''))|trim }) -%}
    {%- endif -%}
    {%- if errors|length > 0 -%}
        {%- set attr = attr|merge({ 'aria-invalid': 'true' }) -%}
    {%- endif -%}
    {{- block('base_form_widget_simple') -}}
{%- endblock form_widget_simple -%}

{%- block datalist_widget -%}
    {{- block('form_widget_simple') -}}
    <datalist id="{{ id }}_suggestions">
        {%- for suggestion in suggestions -%}
            <option value="{{ suggestion }}"></option>
        {%- endfor -%}
    </datalist>
{%- endblock datalist_widget -%}

{%- block form_label -%}
    {%- set label_attr = label_attr|merge({ class: (label_attr.class|default('') ~ ' admin-label')|trim }) -%}
    {{- block('base_form_label') -}}
{%- endblock form_label -%}

{%- block form_label_content -%}
    {{- block('base_form_label_content') -}}
    {%- if not required -%}
        <span class="font-normal text-gray-400"> (optional)</span>
    {%- endif -%}
{%- endblock form_label_content -%}

{%- block form_help -%}
    {%- set help_attr = help_attr|merge({ class: (help_attr.class|default('') ~ ' admin-help')|trim }) -%}
    {{- block('base_form_help') -}}
{%- endblock form_help -%}

{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        {%- if compound -%}
            <div class="mb-4 rounded-lg bg-red-50 px-4 py-3 text-sm font-semibold text-pokered dark:bg-red-950/50 dark:text-red-400" role="alert">
                {%- for error in errors -%}<p>{{ error.message }}</p>{%- endfor -%}
            </div>
        {%- else -%}
            {%- for error in errors -%}
                <p class="admin-error">{{ error.message }}</p>
            {%- endfor -%}
        {%- endif -%}
    {%- endif -%}
{%- endblock form_errors -%}
