{#
    Tailwind form theme for the admin forms.
#}
{% use 'form_div_layout.html.twig' with
    form_widget_simple as base_form_widget_simple,
    choice_widget_collapsed as base_choice_widget_collapsed,
    form_label as base_form_label,
    form_label_content as base_form_label_content,
    form_help as base_form_help %}

{%- block form_row -%}
    <div{% with { attr: row_attr } %}{{ block('attributes') }}{% endwith %}>
        {{- form_label(form) -}}
        {%- if attr['data-temp-id-target'] is defined -%}
            <div class="flex gap-2">
                {{- form_widget(form) -}}
                <button type="button" class="btn btn--ghost flex-none px-3" data-temp-id-generate
                        title="Fill in a temporary ID based on the name">Temp ID</button>
            </div>
        {%- else -%}
            {{- form_widget(form) -}}
        {%- endif -%}
        {{- form_errors(form) -}}
        {{- form_help(form) -}}
    </div>
{%- endblock form_row -%}

{%- block form_widget_simple -%}
    {%- if type|default('text') != 'hidden' -%}
        {%- set attr = attr|merge({ class: (attr.class|default('') ~ ' admin-input' ~ (errors|length > 0 ? ' admin-input--error' : ''))|trim }) -%}
    {%- endif -%}
    {%- if errors|length > 0 -%}
        {%- set attr = attr|merge({ 'aria-invalid': 'true' }) -%}
    {%- endif -%}
    {{- block('base_form_widget_simple') -}}
{%- endblock form_widget_simple -%}

{%- block choice_widget_collapsed -%}
    {%- set attr = attr|merge({ class: (attr.class|default('') ~ ' admin-input' ~ (errors|length > 0 ? ' admin-input--error' : ''))|trim }) -%}
    {{- block('base_choice_widget_collapsed') -}}
{%- endblock choice_widget_collapsed -%}

{#- Text input + suggestion list (free text still allowed); behaviour in form.html.twig -#}
{%- block datalist_widget -%}
    <div class="combobox" data-combobox>
        {%- set attr = attr|merge({
            class: (attr.class|default('') ~ ' pr-10')|trim,
            role: 'combobox',
            autocomplete: 'off',
            'aria-autocomplete': 'list',
            'aria-expanded': 'false',
            'aria-controls': id ~ '_listbox',
        }) -%}
        {{- block('form_widget_simple') -}}
        {%- if suggestions is not empty -%}
            <button type="button" class="combobox__toggle" tabindex="-1" aria-label="Show all suggestions" data-combobox-toggle>
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
        {%- endif -%}
        <ul id="{{ id }}_listbox" class="combobox__list" role="listbox" aria-label="{{ label|default(name) }}" hidden data-combobox-list>
            {%- for suggestion in suggestions -%}
                <li id="{{ id }}_option_{{ loop.index }}" role="option" class="combobox__option" aria-selected="false" data-value="{{ suggestion }}">{{ suggestion }}</li>
            {%- endfor -%}
        </ul>
    </div>
{%- endblock datalist_widget -%}

{%- block form_label -%}
    {%- set label_attr = label_attr|merge({ class: (label_attr.class|default('') ~ ' admin-label')|trim }) -%}
    {{- block('base_form_label') -}}
{%- endblock form_label -%}

{%- block form_label_content -%}
    {{- block('base_form_label_content') -}}
    {%- if not required -%}
        <span class="font-normal text-gray-400"> (optional)</span>
    {%- endif -%}
{%- endblock form_label_content -%}

{%- block form_help -%}
    {%- set help_attr = help_attr|merge({ class: (help_attr.class|default('') ~ ' admin-help')|trim }) -%}
    {{- block('base_form_help') -}}
{%- endblock form_help -%}

{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        {%- if compound -%}
            <div class="mb-4 rounded-lg bg-red-50 px-4 py-3 text-sm font-semibold text-pokered dark:bg-red-950/50 dark:text-red-400" role="alert">
                {%- for error in errors -%}<p>{{ error.message }}</p>{%- endfor -%}
            </div>
        {%- else -%}
            {%- for error in errors -%}
                <p class="admin-error">{{ error.message }}</p>
            {%- endfor -%}
        {%- endif -%}
    {%- endif -%}
{%- endblock form_errors -%}
