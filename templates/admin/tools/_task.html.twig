{#
    One background task as a compact row. The status (pill, times, progress,
    log, history) is rendered by the JS in tools.html.twig from data-status,
    and kept up to date by polling while the task runs.
    Params: task {key, label, description, icon, status}, state_labels
#}
{% set status = task.status %}
<li class="task-row" data-task="{{ task.key }}" data-task-label="{{ task.label }}"
    data-status-url="{{ path('admin_tools_status', { task: task.key }) }}"
    data-state="{{ status.state }}" data-status="{{ status|json_encode }}">
    <span class="task-row__icon">
        <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ task.icon|raw }}</svg>
    </span>

    <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
            <h4 class="text-sm font-semibold text-gray-900 dark:text-white">{{ task.label }}</h4>
            <span class="status-pill status-pill--{{ status.state }}" data-task-pill>{{ state_labels[status.state] }}</span>
        </div>
        <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">{{ task.description }}</p>

        <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-500 dark:text-gray-400">
            <span data-task-time></span>
            <span class="flex items-center gap-1" data-task-history aria-label="Recent runs"></span>
        </div>

        <div class="mt-2.5" data-task-progress hidden>
            <div class="progress-bar" role="progressbar" aria-label="{{ task.label }} progress" data-task-progress-bar>
                <div class="progress-bar__fill" data-task-progress-fill></div>
            </div>
            <p class="mt-1 text-xs tabular-nums text-gray-500 dark:text-gray-400" data-task-progress-label></p>
        </div>

        <details class="mt-2" data-task-log hidden>
            <summary class="cursor-pointer select-none text-xs font-semibold text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white">Log</summary>
            <pre class="log-view" data-task-output></pre>
        </details>
    </div>

    {# Run, or Cancel while running (swapped by the JS) #}
    <form method="post" action="{{ path('admin_tools_run', { task: task.key }) }}" class="flex-none" data-task-run-form {{ status.state == 'running' ? 'hidden' }}>
        <input type="hidden" name="_token" value="{{ csrf_token('run-' ~ task.key) }}">
        <button type="submit" class="btn btn--ghost px-3 py-1.5" data-task-run>
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l10-6.5-10-6.5z"/></svg>
            Run
        </button>
    </form>
    <form method="post" action="{{ path('admin_tools_cancel', { task: task.key }) }}" class="flex-none" data-task-cancel-form {{ status.state == 'running' ? '' : 'hidden' }}>
        <input type="hidden" name="_token" value="{{ csrf_token('cancel-' ~ task.key) }}">
        <button type="submit" class="btn btn--ghost px-3 py-1.5 text-pokered dark:text-red-400" data-task-cancel>
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="1.5"/></svg>
            Cancel
        </button>
    </form>
</li>
