{% extends 'admin/layout.html.twig' %}

{#
    Params: import_form, tasks (list of {key, label, description, status {state, started_at, finished_at, output}})
#}

{% form_theme import_form 'admin/_form_theme.html.twig' %}

{% set state_labels = { idle: 'Never run', running: 'Running…', success: 'Done', failed: 'Failed' } %}

{% block title %}Tools{% endblock %}

{% block body %}
    <div class="mb-5">
        <h1 class="text-2xl font-extrabold tracking-tight text-gray-900 dark:text-white">Tools</h1>
        <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400">Import cards and run maintenance jobs.</p>
    </div>

    <div class="grid max-w-5xl items-start gap-5 xl:grid-cols-2">
        {# Import cards CSV ---------------------------------------------------- #}
        <section class="admin-panel xl:row-span-2">
            {{ form_start(import_form, { attr: { novalidate: 'novalidate', 'data-import-form': true } }) }}
                <div class="p-5">
                    <h2 class="text-base font-bold">Import cards CSV</h2>
                    <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400">
                        Columns: <code class="font-mono text-xs">{{ constant('App\\Service\\DatabaseManager::CARDS_CSV_COLUMNS')|join(', ') }}</code>
                    </p>
                    <div class="mt-4 grid gap-x-4 gap-y-5 sm:grid-cols-2">
                        {{ form_errors(import_form) }}
                        {% for child in import_form %}
                            {% if child.vars.name != '_token' %}{{ form_row(child) }}{% endif %}
                        {% endfor %}
                    </div>
                </div>
                <div class="flex justify-end rounded-b-xl border-t border-gray-100 bg-gray-50 px-5 py-3 dark:border-gray-800 dark:bg-gray-950/40">
                    <button type="submit" class="btn btn--primary">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3M7 8l5-5 5 5M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4"/></svg>
                        Import
                    </button>
                </div>
            {{ form_end(import_form) }}
        </section>

        {# Background tasks ----------------------------------------------------- #}
        {% for task in tasks %}
            {% set status = task.status %}
            <section class="admin-panel p-5" data-task="{{ task.key }}" data-task-label="{{ task.label }}"
                     data-status-url="{{ path('admin_tools_status', { task: task.key }) }}" data-state="{{ status.state }}">
                <div class="flex flex-wrap items-start gap-3">
                    <div class="min-w-0 flex-1">
                        <h2 class="text-base font-bold">{{ task.label }}</h2>
                        <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400">{{ task.description }}</p>
                    </div>
                    <span class="status-pill status-pill--{{ status.state }}" data-task-pill>
                        {% if status.state == 'running' %}<span class="spinner h-3 w-3 border"></span>{% endif %}
                        <span data-task-pill-label>{{ state_labels[status.state] }}</span>
                    </span>
                </div>

                <p class="mt-3 text-xs text-gray-500 dark:text-gray-400" data-task-time
                   data-started="{{ status.started_at }}" data-finished="{{ status.finished_at }}"></p>

                <details class="mt-2" data-task-output-wrap {{ status.output ? '' : 'hidden' }}>
                    <summary class="cursor-pointer text-xs font-semibold text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white">Output</summary>
                    <pre class="mt-2 max-h-56 overflow-auto rounded-lg bg-gray-950 p-3 text-[11px] leading-relaxed text-gray-200" data-task-output>{{ status.output }}</pre>
                </details>

                <form method="post" action="{{ path('admin_tools_run', { task: task.key }) }}" class="mt-4">
                    <input type="hidden" name="_token" value="{{ csrf_token('run-' ~ task.key) }}">
                    <button type="submit" class="btn btn--ghost" data-task-run {{ status.state == 'running' ? 'disabled' }}>
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l10-6.5-10-6.5z"/></svg>
                        Run now
                    </button>
                </form>
            </section>
        {% endfor %}
    </div>

    {# Confirmation before replacing all cards #}
    <dialog id="replace-dialog" class="admin-dialog" aria-labelledby="replace-dialog-title">
        <div class="p-5">
            <h2 id="replace-dialog-title" class="text-base font-bold">Replace all cards?</h2>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
                Every Pokémon card in your collection is deleted and replaced by the cards in this CSV. Images on disk are kept.
            </p>
        </div>
        <div class="flex justify-end gap-2 rounded-b-2xl border-t border-gray-100 bg-gray-50 px-5 py-3 dark:border-gray-800 dark:bg-gray-950/40">
            <button type="button" class="btn btn--ghost" data-replace-cancel autofocus>Cancel</button>
            <button type="button" class="btn btn--danger" data-replace-confirm>Replace everything</button>
        </div>
    </dialog>
{% endblock %}

{% block javascripts %}
    <script>
        (function () {
            // Confirm "Replace all cards" before submitting ----------------------
            const form = document.querySelector('[data-import-form]');
            const dialog = document.getElementById('replace-dialog');
            let confirmed = false;
            form.addEventListener('submit', (e) => {
                const mode = form.querySelector('select[name$="[mode]"]');
                if (mode.value === '{{ constant('App\\Form\\Admin\\CardsImportFormType::MODE_REPLACE') }}' && !confirmed) {
                    e.preventDefault();
                    dialog.showModal();
                }
            });
            dialog.querySelector('[data-replace-cancel]').addEventListener('click', () => dialog.close());
            dialog.querySelector('[data-replace-confirm]').addEventListener('click', () => {
                confirmed = true;
                dialog.close();
                form.requestSubmit();
            });

            // Background task status ---------------------------------------------
            const labels = {{ state_labels|json_encode|raw }};
            const formatTime = (ts) => new Date(ts * 1000).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' });

            const render = (card, status) => {
                const previous = card.dataset.state;
                card.dataset.state = status.state;

                const pill = card.querySelector('[data-task-pill]');
                pill.className = 'status-pill status-pill--' + status.state;
                pill.innerHTML = (status.state === 'running' ? '<span class="spinner h-3 w-3 border"></span>' : '') + '<span></span>';
                pill.lastElementChild.textContent = labels[status.state];

                const time = card.querySelector('[data-task-time]');
                if (status.state === 'running' && status.started_at) {
                    time.textContent = 'Started ' + formatTime(status.started_at);
                } else if (status.finished_at) {
                    time.textContent = 'Last run ' + formatTime(status.finished_at);
                } else {
                    time.textContent = '';
                }

                card.querySelector('[data-task-output-wrap]').hidden = !status.output;
                const output = card.querySelector('[data-task-output]');
                output.textContent = status.output;
                output.scrollTop = output.scrollHeight;
                card.querySelector('[data-task-run]').disabled = status.state === 'running';

                if (previous === 'running' && status.state !== 'running') {
                    const label = card.dataset.taskLabel;
                    showToast(status.state === 'success' ? 'success' : 'error', status.state === 'success' ? label + ' finished.' : label + ' failed. See the output.');
                }
            };

            document.querySelectorAll('[data-task]').forEach((card) => {
                const time = card.querySelector('[data-task-time]');
                render(card, {
                    state: card.dataset.state,
                    started_at: Number(time.dataset.started) || null,
                    finished_at: Number(time.dataset.finished) || null,
                    output: card.querySelector('[data-task-output]').textContent,
                });

                // Poll while running.
                const poll = async () => {
                    if (card.dataset.state !== 'running') return;
                    try {
                        const response = await fetch(card.dataset.statusUrl, { headers: { Accept: 'application/json' } });
                        if (response.ok) render(card, await response.json());
                    } catch (e) { /* network hiccup: try again next tick */ }
                    setTimeout(poll, 3000);
                };
                setTimeout(poll, 3000);
            });
        })();
    </script>
{% endblock %}
