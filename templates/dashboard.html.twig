{% extends 'base.html.twig' %}

{#
    Home dashboard: one tile per collection with its key numbers.
    Params: config, pokemon_stats {owned, binder, missing, missing_unique}, lego_stats {owned}
#}

{% macro stat(label, value, href, dot_class) %}
    <a href="{{ href }}" class="group flex flex-col gap-1 rounded-xl bg-gray-50 px-4 py-3 transition hover:bg-gray-100 dark:bg-gray-800/50 dark:hover:bg-gray-800">
        <span class="flex items-center gap-1.5 text-xs font-semibold text-gray-500 dark:text-gray-400">
            {% if dot_class %}<span class="h-2 w-2 rounded-full {{ dot_class }}"></span>{% endif %}
            {{ label }}
        </span>
        <span class="text-2xl font-extrabold tabular-nums tracking-tight text-gray-900 group-hover:text-pokeblue dark:text-white dark:group-hover:text-blue-400">
            {{ value|number_format(0, ',', '.') }}
        </span>
    </a>
{% endmacro %}

{% macro tile_header(title, icon, href) %}
    <div class="mb-4 flex items-center gap-3">
        <span class="grid h-10 w-10 place-items-center rounded-full bg-pokeblue/10 text-pokeblue dark:bg-pokeblue/20 dark:text-blue-300">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ icon|raw }}</svg>
        </span>
        <h2 class="text-lg font-bold tracking-tight">{{ title }}</h2>
        <a href="{{ href }}" class="ml-auto text-sm font-semibold text-pokeblue hover:underline dark:text-blue-400">Open →</a>
    </div>
{% endmacro %}

{% block body %}
    <div class="mb-6">
        <h1 class="text-2xl font-extrabold tracking-tight text-gray-900 sm:text-3xl dark:text-white">Dashboard</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Your collections at a glance.</p>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
        <section class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-800 dark:bg-gray-900">
            {{ _self.tile_header('Pokémon', '<circle cx="12" cy="12" r="9"/><path d="M3 12h6M15 12h6"/><circle cx="12" cy="12" r="3"/>', path('pokemon_overview')) }}
            <div class="grid grid-cols-2 gap-3">
                {{ _self.stat('Cards', pokemon_stats.owned, path('pokemon_overview')) }}
                {{ _self.stat('In binder', pokemon_stats.binder, path('pokemon_binder'), 'bg-pokeblue') }}
                {{ _self.stat('Missing', pokemon_stats.missing, path('pokemon_missing'), 'bg-pokered') }}
                {{ _self.stat('Missing unique', pokemon_stats.missing_unique, path('pokemon_missing_unique'), 'bg-pokeyellow') }}
            </div>
        </section>

        <section class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-800 dark:bg-gray-900">
            {{ _self.tile_header('LEGO', '<rect x="8" y="2.5" width="8" height="7" rx="2"/><path d="M10.5 2.5v-1h3v1"/><path d="M6 21v-7a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v7"/><path d="M12 14v7"/>', path('lego_overview')) }}
            <div class="grid grid-cols-2 gap-3">
                {{ _self.stat('Minifigures', lego_stats.owned, path('lego_overview')) }}
            </div>
        </section>
    </div>
{% endblock %}
