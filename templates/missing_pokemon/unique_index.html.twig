{% extends 'base.html.twig' %}

{% block body %}
    <div class="mb-5 flex flex-wrap items-center gap-3">
        <span class="stat-pill">
            <span class="h-2 w-2 rounded-full bg-pokered"></span>
            {% if pokemon|length > 0 %}
                Missing: {{ pokemon|length }} unique (+ {{ total }} forms)
            {% else %}
                Missing: {{ total }} forms
            {% endif %}
        </span>
    </div>

    {% macro section(label, count) %}
        <div class="serie-header">
            <span class="serie-header__label">{{ label }} <span class="text-gray-400">[{{ count }}]</span></span>
            <span class="serie-header__rule"></span>
        </div>
    {% endmacro %}

    {% import _self as ui %}

    {% if pokemon|length == 0 %}
        <div class="my-8 rounded-2xl border border-pokeyellow/40 bg-gradient-to-r from-pokered/10 via-pokeyellow/10 to-pokeblue/10 p-8 text-center">
            <h1 class="bg-gradient-to-r from-pokered via-pokeyellow to-pokeblue bg-clip-text text-3xl font-extrabold text-transparent sm:text-4xl">
                All Unique Pokémon Collected! 🎉
            </h1>
        </div>
    {% endif %}

    <div class="space-y-8">
        {% if pokemon|length > 0 %}
            <section>
                {{ ui.section('Missing Unique Pokémon', pokemon|length) }}
                <div class="grid grid-cols-3 gap-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8">
                    {% for p in pokemon %}
                        {% include '_components/card.html.twig' with {
                            href: p.getTcgDexUrl(),
                            img_src: asset('images/missing-unique/' ~ p.getTitle() ~ '.png'),
                            alt: p.title,
                            title: p.title,
                            target: '_blank',
                        } only %}
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        {% set regional = [
            { label: 'Missing Alolan Pokémon',   list: missing_alolan },
            { label: 'Missing Galarian Pokémon', list: missing_galarian },
            { label: 'Missing Hisuian Pokémon',  list: missing_hisuian }
        ] %}

        {% for group in regional %}
            {% if group.list|length > 0 %}
                <section>
                    {{ ui.section(group.label, group.list|length) }}
                    <div class="grid grid-cols-3 gap-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8">
                        {% for p in group.list %}
                            {% include '_components/card.html.twig' with {
                                href: p[1],
                                img_src: p[1],
                                alt: p[0],
                                title: p[0],
                                target: '_blank',
                            } only %}
                        {% endfor %}
                    </div>
                </section>
            {% endif %}
        {% endfor %}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% embed '_components/lazy_loading_js.html.twig' %}{% endembed %}
{% endblock %}
