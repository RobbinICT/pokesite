{% extends 'base.html.twig' %}

{% block body %}
    <div class="mb-5 flex flex-wrap items-center gap-3">
        <span class="stat-pill">
            <span class="h-2 w-2 rounded-full bg-pokered"></span>
            Missing: {{ total }}
        </span>
        {% if search_string is not empty %}
            <span class="text-sm text-gray-500 dark:text-gray-400">
                Results for <span class="font-semibold text-gray-800 dark:text-gray-200">"{{ search_string }}"</span>
            </span>
        {% endif %}
    </div>

    {% if pokemon is empty %}
        <div class="flex flex-col items-center justify-center py-24 text-center">
            <h2 class="text-lg font-semibold text-gray-700 dark:text-gray-300">Nothing missing here 🎉</h2>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                {% if search_string is not empty %}No missing cards match your search.{% else %}This list is complete.{% endif %}
            </p>
        </div>
    {% else %}
        <div id="card-grid"
             class="grid grid-cols-3 gap-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8"
             data-type="missing"
             data-endpoint="{{ path('api_missing_batch') }}"
             data-q="{{ search_string|default('') }}"
             data-offset="{{ batch_size }}"
             data-batch-size="{{ batch_size }}"
             data-last-serie="{{ pokemon|last.serie }}"
             data-has-more="{{ has_more ? '1' : '0' }}">
            {% include 'missing_pokemon/_batch.html.twig' with { config: config, pokemon: pokemon, last_serie: '' } %}
        </div>

        <div id="scroll-loader" class="scroll-loader"><span class="spinner"></span></div>
        <div id="scroll-sentinel" aria-hidden="true"></div>
    {% endif %}

    {% embed '_components/back_to_top_button.html.twig' %}{% endembed %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% embed '_components/infinite_scroll_js.html.twig' %}{% endembed %}
{% endblock %}
