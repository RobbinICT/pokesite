{% extends 'base.html.twig' %}

{% block body %}
    {% if search_string is not empty %}
        <p class="mb-4 text-sm text-gray-500 dark:text-gray-400">
            Results for <span class="font-semibold text-gray-800 dark:text-gray-200">"{{ search_string }}"</span>
        </p>
    {% endif %}

    {% if minifigures is empty %}
        <div class="flex flex-col items-center justify-center py-24 text-center">
            <div class="spinner mb-4 opacity-0"></div>
            <h2 class="text-lg font-semibold text-gray-700 dark:text-gray-300">No minifigures found</h2>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                {% if search_string is not empty %}Try a different search term.{% else %}This list is empty.{% endif %}
            </p>
        </div>
    {% else %}
        <div id="card-grid"
             class="grid grid-cols-3 gap-3 sm:grid-cols-4 md:grid-cols-5 xl:grid-cols-7 2xl:grid-cols-8"
             data-type="lego"
             data-endpoint="{{ path('api_lego_batch') }}"
             data-q="{{ search_string|default('') }}"
             data-offset="{{ batch_size }}"
             data-batch-size="{{ batch_size }}"
             data-has-more="{{ has_more ? '1' : '0' }}">
            {% include 'lego/_batch.html.twig' with { config: config, minifigures: minifigures } %}
        </div>

        <div id="scroll-loader" class="scroll-loader"><span class="spinner"></span></div>
        <div id="scroll-sentinel" aria-hidden="true"></div>
    {% endif %}

    {% embed '_components/back_to_top_button.html.twig' %}{% endembed %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% embed '_components/infinite_scroll_js.html.twig' %}{% endembed %}
{% endblock %}
