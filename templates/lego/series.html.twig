{% extends 'base.html.twig' %}

{#
    The collection grouped by series, wishlist figures faded in between.
    Params: config, groups (series => list of Minifigure), search_string
#}

{% block body %}
    {% set all = groups|reduce((carry, minifigures) => carry|merge(minifigures), []) %}
    {% set wanted = all|filter(m => m.wanted)|length %}

    <div class="mb-4 flex flex-wrap items-center gap-3">
        <span class="stat-pill">
            <span class="h-2 w-2 rounded-full bg-pokeyellow"></span>
            Minifigures: {{ all|length - wanted }}
        </span>
        {# Series with only wishlist figures don't count as collected #}
        <span class="stat-pill">Series: {{ groups|filter(minifigures => minifigures|filter(m => not m.wanted)|length > 0)|length }}</span>
        {% if wanted %}
            <a href="{{ path('lego_wishlist') }}" class="stat-pill hover:bg-gray-200 dark:hover:bg-gray-700">
                <span class="h-2 w-2 rounded-full bg-pokered"></span>
                On wishlist: {{ wanted }}
            </a>
        {% endif %}
        {% if search_string is not empty %}
            <span class="text-sm text-gray-500 dark:text-gray-400">
                Results for <span class="font-semibold text-gray-800 dark:text-gray-200">"{{ search_string }}"</span>
            </span>
        {% endif %}
    </div>

    {% if groups is empty %}
        <div class="flex flex-col items-center justify-center py-24 text-center">
            <h2 class="text-lg font-semibold text-gray-700 dark:text-gray-300">No minifigures found</h2>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                {% if search_string is not empty %}Try a different search term.{% else %}This list is empty.{% endif %}
            </p>
        </div>
    {% else %}
        {% include 'lego/_groups.html.twig' with { config: config, groups: groups, mark_wanted: true } only %}
    {% endif %}

    {% embed '_components/back_to_top_button.html.twig' %}{% endembed %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% embed '_components/lazy_loading_js.html.twig' %}{% endembed %}
{% endblock %}
