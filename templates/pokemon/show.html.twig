{% extends 'base.html.twig' %}

{% block title %}{{ pokemon.name }} — Robbin's Pokésite{% endblock %}

{% block body %}
    {% set img_src = config.getUseLocalCards() == 'true'
        ? asset('images/pokemon/' ~ pokemon.getUniqueIdentifierV2()|url_encode ~ '.png')
        : pokemon.url %}

    <a href="{{ path('show_all_pokemon') }}"
       class="mb-6 inline-flex items-center gap-1.5 text-sm font-medium text-gray-500 hover:text-pokeblue dark:text-gray-400">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Back to list
    </a>

    <div class="mx-auto grid max-w-3xl gap-8 rounded-2xl border border-gray-200 bg-white p-5 shadow-sm sm:p-8 md:grid-cols-2 dark:border-gray-800 dark:bg-gray-900">
        <div class="mx-auto w-full max-w-xs">
            <img class="aspect-card w-full rounded-xl object-cover shadow-lg"
                 src="{{ img_src }}" alt="{{ pokemon.name }}"
                 onerror="this.onerror=null; this.src='/images/placeholder/card_placeholder.png';">
        </div>

        <div class="flex flex-col">
            <span class="text-sm font-semibold text-pokered">#{{ pokemon.dex_nr }}</span>
            <h1 class="mt-1 text-2xl font-extrabold tracking-tight text-gray-900 sm:text-3xl dark:text-white">
                {{ pokemon.name }}
            </h1>

            <dl class="mt-6 space-y-3 text-sm">
                <div class="flex justify-between border-b border-gray-100 pb-2 dark:border-gray-800">
                    <dt class="text-gray-500 dark:text-gray-400">Series</dt>
                    <dd class="font-medium text-gray-900 dark:text-white">{{ pokemon.serie }}</dd>
                </div>
                <div class="flex justify-between border-b border-gray-100 pb-2 dark:border-gray-800">
                    <dt class="text-gray-500 dark:text-gray-400">Card number</dt>
                    <dd class="font-medium text-gray-900 dark:text-white">#{{ pokemon.serie_nr }}</dd>
                </div>
                <div class="flex justify-between border-b border-gray-100 pb-2 dark:border-gray-800">
                    <dt class="text-gray-500 dark:text-gray-400">Generation</dt>
                    <dd class="font-medium text-gray-900 dark:text-white">{{ pokemon.gen }}</dd>
                </div>
            </dl>

            {% if pokemon.generatePokellectorUrl() %}
                <a href="{{ pokemon.generatePokellectorUrl() }}" target="_blank" rel="noopener"
                   class="mt-8 inline-flex items-center justify-center gap-2 rounded-full bg-pokeblue px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-pokeblue-dark">
                    View on Pokellector
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M7 17L17 7M17 7H8M17 7v9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </a>
            {% endif %}
        </div>
    </div>
{% endblock %}
